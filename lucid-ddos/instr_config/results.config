# results.config - LUCID DDoS lab
# Values must not contain ':' - labedit splits fields on it and would drop the part before it.
# Stage checks: check.py prints "<stage> stage - <score> % of the rules pass" (stdout is captured).
window_check = server:check.py.stdout : CONTAINS : window stage - 100 % of the rules pass
flows_check = server:check.py.stdout : CONTAINS : flows stage - 100 % of the rules pass
normalize_check = server:check.py.stdout : CONTAINS : normalize stage - 100 % of the rules pass
features_check = server:check.py.stdout : CONTAINS : features stage - 100 % of the rules pass
shape_check = server:check.py.stdout : CONTAINS : shape stage - 100 % of the rules pass
# Reference results: check.py --stage results found every run of the lab sheet with the expected settings and result.
results_check = server:check.py.stdout : CONTAINS : results stage - 100 % of the reference runs match
# Experiments: 09_plot.py drew the comparison figure + table (results/plots/figure<k>_<group>.png).
normalization_compared = server:09_plot.py.stdout : CONTAINS : _normalization.png
features_compared = server:09_plot.py.stdout : CONTAINS : _features.png
shape_compared = server:09_plot.py.stdout : CONTAINS : _shape.png
# Feature selection: a model was also tested on the address-swapped copy of the test split.
address_swap_tested = server:07_infer.py.stdout : CONTAINS : test_newaddr samples classified
# Classical detection: 14_classical.py was run on a distributed attack (--bots) and the comparison drawn.
classical_tested = server:14_classical.py.stdout : CONTAINS : distributed attack
classical_compared = server:09_plot.py.stdout : CONTAINS : _classical.png
# Explaining the model: 15_explain.py printed the permutation importance of a model.
decisions_explained = server:15_explain.py.stdout : CONTAINS : permutation importance
# Training on another network: a model trained on the CIC-DDoS2019 sample was tested on the lab network,
# and the comparison was drawn.
network_shift_tested = server:07_infer.py.stdout : CONTAINS : trained on CIC-DDoS2019 sample, tested on lab network
shift_compared = server:09_plot.py.stdout : CONTAINS : _shift.png
# Post-lab: the post-incident report written by 11_incident_report.py after live detection.
incident_report = server:results/incident_report.txt : CONTAINS : POST-INCIDENT REPORT
attacker1_blocked = server:results/incident_report.txt : CONTAINS : - 172.30.0.66
attacker2_blocked = server:results/incident_report.txt : CONTAINS : - 172.30.0.67
_two_blocked = server:results/incident_report.txt : CONTAINS : IPs blocked ............ 2
