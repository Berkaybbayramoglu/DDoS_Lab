# results.config - LUCID DDoS lab
# Values must not contain ':' - labedit splits fields on it and would drop the part before it.
#
# One result per checkpoint of the lab sheet, in its order. Most come from the captured stdout of the
# lab scripts; the experiment checkpoints and the end of the lab come from results/time_result.json,
# which the lab scripts write (server/progress.py: one line per checkpoint, "passed" only once it was
# passed). Four of its times are also written as files of one line per minute (results/gradelab/,
# progress.py), so gradelab shows them as whole numbers; all times of a class are collected with
# tools/time_report.py.
#
#SUM: Checkpoints of the LUCID DDoS lab. Y = passed. The quiz columns give the number of correct
# answers in the first attempt (pre-lab 10 questions, post-lab 8); the four time columns are whole
# minutes. All times per student and checkpoint are in results/time_result.json of each submission;
# tools/time_report.py lists them for the class.
#
# Quizzes (quiz.py): the first attempt, one line per question.
_prelab_right = server:results/quiz_prelab.txt : STRING_COUNT : - RIGHT
_postlab_right = server:results/quiz_postlab.txt : STRING_COUNT : - RIGHT
# Times (progress.py): one line per minute
_lab_minutes = server:results/gradelab/lab_minutes.txt : LINE_COUNT
_dataset_min = server:results/gradelab/dataset_min.txt : LINE_COUNT
_results_min = server:results/gradelab/results_min.txt : LINE_COUNT
_training_min = server:results/gradelab/training_min.txt : LINE_COUNT
#
# Stage checks: check.py prints "<stage> stage - <score> % of the rules pass" (stdout is captured).
#DOC: Step 1 - the time windows passed every rule of check.py
window_check = server:check.py.stdout : CONTAINS : window stage - 100 % of the rules pass
#DOC: Step 2 - flows, labels and splits passed every rule of check.py
flows_check = server:check.py.stdout : CONTAINS : flows stage - 100 % of the rules pass
#DOC: Step 3 - the normalization passed every rule of check.py
normalize_check = server:check.py.stdout : CONTAINS : normalize stage - 100 % of the rules pass
#DOC: Step 4 - the feature selection passed every rule of check.py
features_check = server:check.py.stdout : CONTAINS : features stage - 100 % of the rules pass
#DOC: Step 5 - the shaping passed every rule of check.py
shape_check = server:check.py.stdout : CONTAINS : shape stage - 100 % of the rules pass
#DOC: Steps 6-8 - the model 'global' was trained, applied and evaluated with the expected result
baseline_match = server:results/time_result.json : FILE_REGEX : "baseline"\W+"passed"
#DOC: Experiment 1 - all normalization runs match the reference results
exp1_match = server:results/time_result.json : FILE_REGEX : "exp1_normalization"\W+"passed"
#DOC: Experiment 2 - all feature selection runs match the reference results
exp2_match = server:results/time_result.json : FILE_REGEX : "exp2_features"\W+"passed"
#DOC: Experiment 2 - a model was tested on the address-swapped split test_newaddr
address_swap_tested = server:07_infer.py.stdout : CONTAINS : test_newaddr samples classified
#DOC: Experiment 3 - all shaping runs match the reference results
exp3_match = server:results/time_result.json : FILE_REGEX : "exp3_shape"\W+"passed"
#DOC: Experiment 4 - all classical detection runs match the reference results
exp4_match = server:results/time_result.json : FILE_REGEX : "exp4_classical"\W+"passed"
#DOC: Experiment 4 - the classical rule was run against the distributed attack (--bots)
classical_tested = server:14_classical.py.stdout : CONTAINS : distributed attack
#DOC: Experiment 5 - 15_explain.py printed the permutation importance of a model
decisions_explained = server:15_explain.py.stdout : CONTAINS : permutation importance
#DOC: Experiment 5 - the three explanations of the lab sheet match the reference results
exp5_match = server:results/time_result.json : FILE_REGEX : "exp5_explain"\W+"passed"
#DOC: Experiment 6 - all runs of training on another network match the reference results
exp6_match = server:results/time_result.json : FILE_REGEX : "exp6_shift"\W+"passed"
#DOC: Experiment 6 - the model trained on the CIC-DDoS2019 sample was tested on the lab network
network_shift_tested = server:07_infer.py.stdout : CONTAINS : trained on CIC-DDoS2019 sample, tested on lab network
# Reference results: check.py --stage results found every run of the lab sheet with the expected settings and result.
#DOC: All 23 runs of the lab sheet match the reference results (check.py --stage results)
results_check = server:check.py.stdout : CONTAINS : results stage - 100 % of the reference runs match
# Experiments: 09_plot.py drew the comparison figure + table (results/plots/figure<k>_<group>.png).
#DOC: Comparison figure of Experiment 1 drawn (09_plot.py)
normalization_compared = server:09_plot.py.stdout : CONTAINS : _normalization.png
#DOC: Comparison figure of Experiment 2 drawn (09_plot.py)
features_compared = server:09_plot.py.stdout : CONTAINS : _features.png
#DOC: Comparison figure of Experiment 3 drawn (09_plot.py)
shape_compared = server:09_plot.py.stdout : CONTAINS : _shape.png
#DOC: Comparison figure of Experiment 4 drawn (09_plot.py)
classical_compared = server:09_plot.py.stdout : CONTAINS : _classical.png
#DOC: Comparison figure of Experiment 6 drawn (09_plot.py)
shift_compared = server:09_plot.py.stdout : CONTAINS : _shift.png
# Post-lab: the post-incident report written by 11_incident_report.py after live detection.
#DOC: Post-lab - the post-incident report was written by 11_incident_report.py
incident_report = server:results/incident_report.txt : CONTAINS : POST-INCIDENT REPORT
#DOC: Post-lab - attacker1 (172.30.0.66) was blocked in the live test
attacker1_blocked = server:results/incident_report.txt : CONTAINS : - 172.30.0.66
#DOC: Post-lab - attacker2 (172.30.0.67) was blocked in the live test
attacker2_blocked = server:results/incident_report.txt : CONTAINS : - 172.30.0.67
_two_blocked = server:results/incident_report.txt : CONTAINS : IPs blocked ............ 2
#DOC: Post-lab - every expected result of the live test reached (both attackers blocked, the client
# not, recall 100 %, no false positives)
incident_match = server:results/time_result.json : FILE_REGEX : "incident"\W+"passed"
#DOC: The last script of the lab (11_incident_report.py) completed; its time is the end time of the lab
lab_finished = server:results/time_result.json : FILE_REGEX : "lab_finish"
#
# Current state for checkwork (Labtainer 6.4.1): the prestop script prints the progress table of
# progress.py when checkwork or stoplab runs.
#CHECK_TRUE: Some checkpoints of the lab are not passed yet. Run python3 progress.py in the server terminal to see which ones and the command for the next one.
cw_all_passed = server:prestop.stdout : CONTAINS : all checkpoints passed - yes
#CHECK_OK: All checkpoints of the lab are passed.
