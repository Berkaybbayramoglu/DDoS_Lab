# goals.config - LUCID DDoS lab
#DOC: Pre-lab quiz - correct answers in the first attempt (of 10; empty = not taken)
prelab_quiz = value : _prelab_right
#DOC: Post-lab - only the two attackers were blocked (both attacker addresses listed and exactly two
# blocked, so the benign client was not)
only_attackers_blocked = count_greater : 2 : (attacker1_blocked, attacker2_blocked, _two_blocked)
#DOC: Post-lab quiz - correct answers in the first attempt (of 8; empty = not taken)
postlab_quiz = value : _postlab_right
