    GLOBAL_SETTINGS
    LAB_MASTER_SEED lucid-ddos_student_master_seed
NETWORK LAB_LAN
     MASK 172.30.0.0/24
     GATEWAY 172.30.0.1
CONTAINER server
     USER ubuntu
     X11 YES
     TERMINALS 2
     PASSWORD ubuntu
     ADD-HOST LAB_LAN
     LAB_LAN 172.30.0.10
     NO_GW YES
     NUM_CPUS 2
CONTAINER attacker1
     USER ubuntu
     X11 NO
     TERMINALS 0
     PASSWORD ubuntu
     ADD-HOST LAB_LAN
     LAB_LAN 172.30.0.66
     NO_GW YES
     NUM_CPUS 1
CONTAINER attacker2
     USER ubuntu
     X11 NO
     TERMINALS 0
     PASSWORD ubuntu
     ADD-HOST LAB_LAN
     LAB_LAN 172.30.0.67
     NO_GW YES
     NUM_CPUS 1
CONTAINER client
     USER ubuntu
     X11 NO
     TERMINALS 0
     PASSWORD ubuntu
     ADD-HOST LAB_LAN
     LAB_LAN 172.30.0.20
     NO_GW YES
     NUM_CPUS 1
